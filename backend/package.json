{
  "name": "wigo-herbal-backend",
  "version": "1.0.0",
  "description": "WIGO Herbal Traditional Medical Services - Backend API",
  "main": "server.js",
  "scripts": {
    "start"      : "NODE_ENV=production node server.js",
    "dev"        : "nodemon server.js",
    "setup"      : "node scripts/setup-db.js",
    "setup:db"   : "node scripts/setup-db.js",
    "prod"       : "NODE_ENV=production node server.js",
    "pm2:start"  : "pm2 start ecosystem.config.js --env production",
    "pm2:stop"   : "pm2 stop wigo-herbal",
    "pm2:restart": "pm2 restart wigo-herbal",
    "pm2:logs"   : "pm2 logs wigo-herbal",
    "pm2:status" : "pm2 status"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "aos": "^2.3.4",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
