{
  "version": 2,

  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/index.js"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.js"
    },
    {
      "source": "/admin",
      "destination": "/index.js"
    }
  ]
}
